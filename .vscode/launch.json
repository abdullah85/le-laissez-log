{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "aw-server",
      "type": "debugpy",
      "request": "launch",
      "module": "aw_server",
      "console": "integratedTerminal"
    },
    {
      "name": "aw-server (--testing)",
      "type": "debugpy",
      "request": "launch",
      "module": "aw_server",
      "args": ["--testing"],
      "console": "integratedTerminal"
    },
    {
      "name": "aw-watcher-terminal (--testing)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/aw_watcher_terminal.py",
      "args": ["--testing"],
      "console": "integratedTerminal"
    },
    {
      "name": "atuin daemon (debug build, .atuin-output)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/vendor/atuin/target/debug/atuin",
      "args": ["daemon", "start", "--force", "--show-logs"],
      "cwd": "${workspaceFolder}",
      "env": {
        "ATUIN_HOME": "${workspaceFolder}/.atuin-output",
        "ATUIN_UPDATE_CHECK": "false",
        "ATUIN_DAEMON__ENABLED": "true",
        "ATUIN_OUTPUT__ENABLED": "true"
      },
      "sourceLanguages": ["rust"],
      "terminal": "integrated"
    },
    {
      "name": "atuin output search (debug build, .atuin-output)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/vendor/atuin/target/debug/atuin",
      "args": ["output", "search", "${input:atuinQuery}"],
      "cwd": "${workspaceFolder}",
      "env": {
        "ATUIN_HOME": "${workspaceFolder}/.atuin-output",
        "ATUIN_UPDATE_CHECK": "false",
        "ATUIN_DAEMON__ENABLED": "true",
        "ATUIN_OUTPUT__ENABLED": "true"
      },
      "sourceLanguages": ["rust"],
      "terminal": "integrated"
    },
    {
      "name": "atuin pty-proxy (debug build, .atuin-output)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/vendor/atuin/target/debug/atuin",
      "args": ["pty-proxy", "--shell", "/bin/bash", "--shell", "--rcfile", "--shell", "scripts/atuin-trial.bashrc"],
      "cwd": "${workspaceFolder}",
      "env": {
        "ATUIN_HOME": "${workspaceFolder}/.atuin-output",
        "ATUIN_UPDATE_CHECK": "false",
        "ATUIN_DAEMON__ENABLED": "true",
        "ATUIN_OUTPUT__ENABLED": "true"
      },
      "sourceLanguages": ["rust"],
      "terminal": "integrated"
    },
    {
      "name": "atuin history start (debug build, .atuin-output)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/vendor/atuin/target/debug/atuin",
      "args": ["history", "start", "--hook", "--", "${input:atuinCommand}"],
      "cwd": "${workspaceFolder}",
      "env": {
        "ATUIN_HOME": "${workspaceFolder}/.atuin-output",
        "ATUIN_UPDATE_CHECK": "false",
        "ATUIN_DAEMON__ENABLED": "true",
        "ATUIN_OUTPUT__ENABLED": "true",
        "ATUIN_SHELL": "bash"
      },
      "sourceLanguages": ["rust"],
      "terminal": "integrated"
    },
    {
      "name": "atuin history end (debug build, .atuin-output)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/vendor/atuin/target/debug/atuin",
      "args": ["history", "end", "--hook", "--exit", "0", "--", "${input:atuinHistoryId}"],
      "cwd": "${workspaceFolder}",
      "env": {
        "ATUIN_HOME": "${workspaceFolder}/.atuin-output",
        "ATUIN_UPDATE_CHECK": "false",
        "ATUIN_DAEMON__ENABLED": "true",
        "ATUIN_OUTPUT__ENABLED": "true"
      },
      "sourceLanguages": ["rust"],
      "terminal": "integrated"
    },
    {
      "name": "atuin bash hooks (.atuin-output)",
      "type": "bashdb",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug-atuin-hooks.sh",
      "cwd": "${workspaceFolder}",
      "env": {
        "ATUIN_HOME": "${workspaceFolder}/.atuin-output",
        "ATUIN_UPDATE_CHECK": "false",
        "ATUIN_DAEMON__ENABLED": "true",
        "ATUIN_DAEMON__AUTOSTART": "true",
        "ATUIN_OUTPUT__ENABLED": "true"
      },
      "terminalKind": "integrated"
    }
  ],
  "inputs": [
    {
      "id": "atuinQuery",
      "type": "promptString",
      "description": "Words to search for in captured output",
      "default": "capture"
    },
    {
      "id": "atuinCommand",
      "type": "promptString",
      "description": "Command line to record, as the preexec hook would pass it",
      "default": "echo debug-hooks-test"
    },
    {
      "id": "atuinHistoryId",
      "type": "promptString",
      "description": "History id printed by `atuin history start`"
    }
  ]
}
